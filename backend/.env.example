# ============================================
# LifeOS Finance — Backend Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Database ---
# Neon.tech PostgreSQL connection string
# Get yours at: https://neon.tech (free tier)
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?sslmode=require

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- External task authentication ---
# Required by /api/v1/tasks/daily-summary and /weekly-summary
CRON_SECRET=replace-with-a-random-cron-secret

# --- Initial User ---
# These are used to create the first (and only) user on startup
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-secure-password

# --- AI Providers ---
# Set which AI provider to use: "gemini" or "openai"
AI_PROVIDER=gemini

# Gemini (free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key

# --- Telegram ---
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_ID=your-telegram-user-id
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_WEBHOOK_URL=https://your-render-service.onrender.com/api/v1/telegram/webhook

# --- App Settings ---
DEFAULT_CURRENCY=COP
TIMEZONE=America/Bogota
CORS_ORIGINS=["*"]

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
